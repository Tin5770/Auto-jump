--------------------------------------------------------------------------------
-- Helper Function: สร้าง Slider Component
--------------------------------------------------------------------------------
local function createSlider(name, minVal, maxVal, defaultVal, layoutOrder, onValueChanged)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 75)
	frame.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
	frame.BorderSizePixel = 0
	frame.LayoutOrder = layoutOrder
	frame.Parent = contentFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 0, 22)
	label.Position = UDim2.new(0, 5, 0, 3)
	label.Text = name .. ": " .. tostring(defaultVal)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 14
	label.BackgroundTransparency = 1
	label.Parent = frame

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, -20, 0, 8)
	bg.Position = UDim2.new(0, 10, 0, 30)
	bg.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	bg.BorderSizePixel = 0
	bg.Parent = frame

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 4)
	bgCorner.Parent = bg

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fill

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 16, 0, 16)
	btn.Position = UDim2.new(0, -8, 0.5, -8)
	btn.Text = ""
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	btn.Parent = fill

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(1, 0)
	btnCorner.Parent = btn

	local resetBtn = Instance.new("TextButton")
	resetBtn.Size = UDim2.new(1, -20, 0, 20)
	resetBtn.Position = UDim2.new(0, 10, 0, 48)
	resetBtn.Text = "Reset (" .. tostring(defaultVal) .. ")"
	resetBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
	resetBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
	resetBtn.Font = Enum.Font.SourceSans
	resetBtn.TextSize = 12
	resetBtn.Parent = frame

	local resetCorner = Instance.new("UICorner")
	resetCorner.CornerRadius = UDim.new(0, 5)
	resetCorner.Parent = resetBtn

	local currentValue = defaultVal
	local isDragging = false

	local function setValue(val)
		currentValue = math.clamp(math.floor(val), minVal, maxVal)
		label.Text = name .. ": " .. tostring(currentValue)
		local alpha = (currentValue - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		onValueChanged(currentValue)
	end

	local function updateFromInput(input)
		local absolutePos = bg.AbsolutePosition.X
		local absoluteSize = bg.AbsoluteSize.X
		local scale = math.clamp((input.Position.X - absolutePos) / absoluteSize, 0, 1)
		setValue(minVal + (scale * (maxVal - minVal)))
	end

	bg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			updateFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)

	resetBtn.MouseButton1Click:Connect(function()
		setValue(defaultVal)
	end)

	return function() return currentValue end
end

