-- ฟังก์ชั่นสำหรับตั้งค่าการชนคืนเมื่อปิด Noclip
local function disableNoclip()
	local character = localPlayer.Character
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				-- ตั้งค่า CanCollide กลับเป็น true ให้ชิ้นส่วนหลัก
				if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head" then
					part.CanCollide = true
				end
			end
		end
	end
end

noclipBtn.MouseButton1Click:Connect(function()
	noclipEnabled = not noclipEnabled
	if noclipEnabled then
		noclipBtn.Text = "Noclip: ON"
		noclipBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
	else
		noclipBtn.Text = "Noclip: OFF"
		noclipBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		disableNoclip() -- คืนค่า CanCollide ทันทีที่ปิด
	end
end)

-- Loop สำหรับปิด CanCollide ขณะ Noclip ทำงาน
RunService.Stepped:Connect(function()
	if noclipEnabled then
		local character = localPlayer.Character
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
end)

-- Loop การทำงานหลักสำหรับ WalkSpeed / JumpPower / Auto Controls
RunService.RenderStepped:Connect(function()
	local character = localPlayer.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	humanoid.UseJumpPower = true
	
	if humanoid.WalkSpeed ~= currentSpeed then
		humanoid.WalkSpeed = currentSpeed
	end
	
	if humanoid.JumpPower ~= currentJumpPower then
		humanoid.JumpPower = currentJumpPower
	end
	
	if autoJumpEnabled then
		humanoid.Jump = true
	end
	
	if autoWalkEnabled then
		humanoid:Move(Vector3.new(0, 0, -1), true)
	end
end)
